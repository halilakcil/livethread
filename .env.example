# ---------------------------------------------------------------
# LiveThread environment (all values OPTIONAL)
# ---------------------------------------------------------------
# By default, credentials are entered in the in-app setup screen and kept
# in your browser's localStorage. They are sent per request to the local
# Next.js API routes (never stored on the server).
#
# Values below are server-side FALLBACKS used only when the browser does
# not send its own key. Useful for personal, single-user deployments.
# Copy to `.env.local` and fill in what you need.

# Threads long-lived user access token
THREADS_ACCESS_TOKEN=

# LLM keys (used by the AI Studio rewriter)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Threads Graph API base (rarely needs changing)
THREADS_API_BASE=https://graph.threads.net/v1.0

# Set to "true" to open the app in demo mode by default
NEXT_PUBLIC_DEFAULT_MOCK=false
